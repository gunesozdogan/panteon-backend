PORT=3000

# Redis — live ranking + read cache (hot path)
REDIS_URL=redis://localhost:6379

# PostgreSQL — money & source of truth (transactional)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leaderboard

# MongoDB — historical archive (flexible schema)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=leaderboard

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Weekly close cron — distribute pool + reset the board at the week boundary.
# Off by default so tests/scripts never schedule jobs; enable on ONE deployed
# worker. Default schedule = Monday 00:05 UTC (just after the ISO week boundary).
ENABLE_CRON=false
CLOSE_WEEK_CRON=5 0 * * 1
CRON_TIMEZONE=UTC
# Self-healing sweep window: each tick closes the last N ended weeks (not just
# last week), so a missed/failed tick is caught up later. Already-closed weeks
# are cheap no-ops. Default 4 (~one month of catch-up).
CLOSE_SWEEP_WEEKS=4