# Copy to .env and fill in. Never commit .env (secrets).
# Stateless service: all state lives in these stores, not in process memory.

PORT=3000

# Redis — live ranking + read cache (hot path)
REDIS_URL=redis://localhost:6379

# PostgreSQL — money & source of truth (transactional)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leaderboard

# MongoDB — historical archive (flexible schema)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=leaderboard